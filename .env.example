# Host and port of this API. Used to build links inside emails.
# On the dev server: its name, such as 3-110-22-5.sslip.io (also its HTTPS certificate's name).
APP_HOST=localhost:3000

# Where the React app runs. Links in emails, such as invitations, point here.
FRONTEND_URL=http://localhost:5173

# Comma-separated browser origins allowed to call /graphql (CORS). Exact scheme, host and port.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production only, required: comma-separated host names this API answers to, such as api.example.com.
# The dev server sets it from APP_HOST.
ALLOWED_HOSTS=

# Redis, used by Sidekiq for background jobs and, in production, the cache (rate-limit counters).
# The dev server sets its own.
REDIS_URL=redis://localhost:6379/0

# The "from" address on every email. On the dev server, an address verified in Amazon SES.
MAILER_SENDER=BD Assistant <no-reply@example.com>
# The first super admin, created by bin/rails db:seed in any environment. Leave empty to skip.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Allow GraphQL introspection (schema discovery). Leave empty for the default: on in development/test, off in production.
GRAPHQL_INTROSPECTION=

# Deployed servers only (the dev server's deploy/dev/.env). They stay commented here:
# an empty SECRET_KEY_BASE stops Rails from starting on a laptop. On the server,
# remove the "# " in front of each setting and fill it in.

# Signs tokens. Make one with: openssl rand -hex 64
# SECRET_KEY_BASE=

# Password for the PostgreSQL container. Make one with: openssl rand -hex 24
# POSTGRES_PASSWORD=

# Amazon SES SMTP credentials (SES console > SMTP settings), such as
# email-smtp.eu-central-1.amazonaws.com. While SES is in its sandbox, every
# recipient must be a verified address too.
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
