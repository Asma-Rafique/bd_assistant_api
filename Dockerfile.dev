# Development image: Ruby and the system libraries the gems need. The code isn't copied in;
# docker-compose.yml mounts the project folder, so edits on your machine show up at once.
FROM ruby:3.4.11-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libpq-dev libyaml-dev pkg-config postgresql-client && \
    rm -rf /var/lib/apt/lists/*

# Run as a user with your own user id, so files Rails writes (logs, tmp, schema.rb) belong to you, not root.
ARG UID=1000
ARG GID=1000
RUN groupadd -g $GID app && useradd -m -u $UID -g $GID app && chown app:app /usr/local/bundle
USER app

WORKDIR /rails
